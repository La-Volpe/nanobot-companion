captures/

# Local dev gateway (tools/nanobot-dev.sh)
.dev/

# Secrets and signing material: a net, not a fence. Nothing of this kind is
# committed today; the patterns are here so the day one of them lands in the
# worktree, `git add -A` cannot take it to a public repository (T56).
.env*
credentials.json
*.p12
*.jks
*.keystore
*.pem
*.mobileprovision

# macOS
.DS_Store

# Working documents stay local. The repo ships three documents: README.md,
# HUMANS.md and AGENTS.md. Plans, gate evidence, decision logs, agent
# definitions and heartbeat bookkeeping are working material, not deliverables.
.pi/
*.md
!README.md
!HUMANS.md
!AGENTS.md

# Python bytecode from the parity instruments
__pycache__/
